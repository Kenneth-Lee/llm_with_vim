{
	"config": {
    		"engine_type": "ollama",
    		"server_addr": "default",
    		"model": "default",
		"keep_alive": 3600
	},

	"config-comment": {
		"comment": "这是config部分的注释",
		"engine_type": "ollama|deepseek|haijing",
