{
  "name": "llm-with-vscode",
  "displayName": "LLM Chat Assistant",
  "description": "Interactive LLM conversation tool for VSCode, supporting multiple LLM engines",
  "version": "1.0.20260129",
  "publisher": "llm-with-vim",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/Kenneth-Lee-2012/llm_with_vim.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:llm-chat"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "syntaxes/",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "llm-chat.submitQuery",
        "title": "LLM: Submit Query (Append Mode)"
      },
      {
        "command": "llm-chat.submitQueryReplace",
        "title": "LLM: Submit Query (Replace Mode)"
      },
      {
        "command": "llm-chat.stopGeneration",
        "title": "LLM: Stop Generation"
      },
      {
        "command": "llm-chat.showOutline",
        "title": "LLM: Show Outline"
      }
    ],
    "keybindings": [
      {
        "command": "llm-chat.submitQuery",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == llm-chat"
      },
      {
        "command": "llm-chat.submitQueryReplace",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == llm-chat"
      },
      {
        "command": "llm-chat.stopGeneration",
        "key": "shift+k",
        "when": "editorTextFocus && editorLangId == llm-chat"
      },
      {
        "command": "llm-chat.showOutline",
        "key": "f2",
        "when": "editorTextFocus && editorLangId == llm-chat"
      }
    ],
    "languages": [
      {
        "id": "llm-chat",
        "extensions": [".llm"],
        "aliases": ["LLM Chat"]
      }
    ],
    "grammars": [
      {
        "language": "llm-chat",
        "scopeName": "text.llm-chat",
        "path": "./syntaxes/llm-chat.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^14.x",
    "eslint": "^8.0.0"
  }
}
