{
  "schema_version": 1,
  "spec_version": 1,
  "id": "openai_compat",
  "display_name": "OpenAI Compatible",
  "protocol": "openai_compat",
  "defaults": {
    "model": "default",
    "connect_timeout": 30,
    "read_timeout": 1800,
    "stream": true,
    "thinking": false
  },
  "endpoint": {
    "template": "http://{server_addr}/v1/chat/completions",
    "default_host": "localhost",
    "default_port": 80
  },
  "model_query": {
    "url_template": "http://{server_addr}/v1/models"
  },
  "auth": {
    "type": "header",
    "header_name": "Authorization"
  },
  "features": {
    "tools": true,
    "vision": true,
    "reasoning": true,
    "streaming": true
  },
  "aliases": {
    "model": {
      "default": "default"
    },
    "server": {
      "default": "localhost"
    }
  },
  "request_mapping": {
    "messages": "messages",
    "model": "model",
    "temperature": "temperature",
    "max_tokens": "max_tokens",
    "stream": "stream",
    "tools": "tools"
  },
  "response_mapping": {
    "mode": "sse_openai_delta",
    "content_path": "choices[0].delta.content",
    "tool_calls_path": "choices[0].delta.tool_calls"
  },
  "overrides": {
    "allowed_in_session": [
      "model",
      "temperature",
      "max_tokens",
      "tools",
      "thinking",
      "server_addr"
    ],
    "readonly": [
      "protocol",
      "response_mapping.mode"
    ]
  }
}
